# ===========================================================================
# ColonSightAI — Environment Variables
# ===========================================================================
# Copy this file to .env and update with your values.
# NEVER commit .env to version control.
# ===========================================================================

# ── Flask Core ─────────────────────────────────────────────────────────────
FLASK_CONFIG=development
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///data/database/colonsightai.db

# ── File Upload ────────────────────────────────────────────────────────────
UPLOAD_FOLDER=data/uploads
HEATMAP_FOLDER=data/heatmaps
REPORT_FOLDER=data/reports
MAX_CONTENT_LENGTH=16777216

# ── AI Model ──────────────────────────────────────────────────────────────
MODEL_PATH=trained_models/efficientnetb0_colon.h5
MODEL_IMAGE_SIZE=224
CONFIDENCE_THRESHOLD=0.5
# Optional: Remote inference endpoint (Google Colab / Cloud Run)
# REMOTE_INFERENCE_URL=https://xxxx.ngrok-free.app/predict

# ── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG
LOG_FILE=logs/colonsightai.log

# ── Security ──────────────────────────────────────────────────────────────
SESSION_COOKIE_SECURE=False
REMEMBER_COOKIE_DURATION=604800
